<?xml version="1.0" encoding="utf-8"?>
<!-- Tanda di atas layar beberapa menit sebelum gerbang jam tayang tertutup; dipasang RemoteKeyService. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@drawable/banner_overlay"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="24dp"
    android:paddingTop="14dp"
    android:paddingEnd="28dp"
    android:paddingBottom="14dp">

    <ImageView
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_plane_landing"
        android:tint="@color/amber" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.08"
            android:text="@string/landing_soon_title"
            android:textColor="@color/amber"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/landing_soon_hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/flap_text"
            android:textSize="16sp" />
    </LinearLayout>
</LinearLayout>
